{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HTTP Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "cwd": "${workspaceFolder}",
      "env": {
        "LISTEN_ADDR": ":8088",
        "ENABLE_TESTNET_EXECUTE": "0"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "HTTP Server (testnet execute)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENABLE_TESTNET_EXECUTE": "1",
        "LISTEN_ADDR": "127.0.0.1:8088"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Demo (CLI)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/demo",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
