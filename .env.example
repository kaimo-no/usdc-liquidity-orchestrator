# Copy to .env and fill in (never commit real keys or provider secrets).
# Plan-only mode needs none of these.

# LISTEN_ADDR=:8088
# LISTEN_ADDR=127.0.0.1:8088   # required if ENABLE_TESTNET_EXECUTE=1

# --- Optional testnet deposit execute (local / loopback only) ---
# ENABLE_TESTNET_EXECUTE=1
# AGENT_PRIVATE_KEY=0x…
# MAX_AMOUNT_ATOMIC=

# Named RPC placeholders (operator-friendly; EVM used for live Gateway deposit)
RPC_URL_BASE_SEPOLIA=
RPC_URL_ARBITRUM_SEPOLIA=
RPC_URL_ARC_TESTNET=

# Solana Devnet RPC (placeholder for future / ops; not used by EVM DepositExecutor)
RPC_URL_SOLANA_DEVNET=

# Alternates (still supported):
# RPC_URL_eip155_84532=
# RPC_URL_eip155_421614=
# RPC_URL_eip155_5042002=
# RPC_URLS_JSON={"eip155:84532":"https://…"}
