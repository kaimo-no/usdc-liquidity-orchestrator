# Copy to .env and fill secrets (never commit real keys or provider secrets).
# Plan-only mode needs none of the execute secrets.

# --- HTTP ---
# LISTEN_ADDR=:8088
# LISTEN_ADDR=127.0.0.1:8088   # required if ENABLE_TESTNET_EXECUTE=1

# --- Optional testnet execute (local / loopback only) ---
# ENABLE_TESTNET_EXECUTE=1
# AGENT_PRIVATE_KEY=0x…
# MAX_AMOUNT_ATOMIC=

# --- Agent identity (required for scenario plan) ---
# Prefer AGENT_ADDRESS for dry plans. If both set, addresses must match.
AGENT_ADDRESS=0xAgentSelf000000000000000000000000000001
# AGENT_PRIVATE_KEY=0x…   # derives address when AGENT_ADDRESS unset; never commit real keys

# --- Scale (real = floor(logical_atomic / scale); default 1) ---
USDC_SCALE_FACTOR=10

# --- Payment scenario (merchant / x402 claim) — cmd/demo only; not HTTP /v1/plan ---
# PAYMENT_CHAIN is CAIP-2 dest where USDC is withdrawn/minted to agent_self.
PAYMENT_PROTOCOL=x402
PAYMENT_CHAIN=eip155:84532
PAYMENT_AMOUNT_USDC=400
PAYMENT_PAY_TO=0x0000000000000000000000000000000000000001

# CAIP-2 reference (MVP testnets):
#   Base Sepolia      eip155:84532
#   Arbitrum Sepolia  eip155:421614
#   Arc Testnet       eip155:5042002
# Example Arc dest: PAYMENT_CHAIN=eip155:5042002

# --- Hard-coded source split (v1; logical human USDC; must sum to PAYMENT_AMOUNT_USDC) ---
# SOURCE_MODE=auto is not implemented (refused). Omit chain or set 0 to skip.
# SOURCE_MODE=hardcoded
SOURCE_AMOUNT_BASE_SEPOLIA=300
SOURCE_AMOUNT_ARBITRUM_SEPOLIA=100
SOURCE_AMOUNT_ARC_TESTNET=0

# --- USDC contract addresses (docs only; code uses pkg/liquidity registry, no env override) ---
# USDC_ADDRESS_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# USDC_ADDRESS_ARBITRUM_SEPOLIA=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# USDC_ADDRESS_ARC_TESTNET=0x3600000000000000000000000000000000000000

# --- Named RPCs (operator-friendly; EVM used for balance read + Gateway execute) ---
# Base Sepolia      eip155:84532
RPC_URL_BASE_SEPOLIA=
# Arbitrum Sepolia  eip155:421614
RPC_URL_ARBITRUM_SEPOLIA=
# Arc Testnet       eip155:5042002
RPC_URL_ARC_TESTNET=

# Solana Devnet RPC (placeholder for future / ops; not used by EVM DepositExecutor)
RPC_URL_SOLANA_DEVNET=

# Alternates (still supported; same CAIP-2 keys):
# RPC_URL_eip155_84532=
# RPC_URL_eip155_421614=
# RPC_URL_eip155_5042002=
# RPC_URLS_JSON={"eip155:84532":"https://…","eip155:421614":"https://…","eip155:5042002":"https://…"}

# Optional Gateway API override (default testnet public endpoint)
# GATEWAY_API_BASE=https://gateway-api-testnet.circle.com
# Burn-intent maxFee in atomic USDC (default 2010000 = 2.01 USDC)
# GATEWAY_MAX_FEE_ATOMIC=2010000
